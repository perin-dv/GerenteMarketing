# Infra local
POSTGRES_DB=gerentemarketing
POSTGRES_USER=gerentemarketing
POSTGRES_PASSWORD=change-this-local-db-password

# URLs
DATABASE_URL=postgresql://gerentemarketing:change-this-local-db-password@localhost:5432/gerentemarketing?schema=public
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth - gere um segredo longo antes de usar fora do computador local
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Usuário inicial - preencher APENAS no .env local
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=replace-with-local-password
SEED_ADMIN_NAME=Administrador
SEED_COMPANY_NAME=Tem Na Loja
