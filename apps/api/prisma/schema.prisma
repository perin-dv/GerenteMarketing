generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignMode {
  ORGANIC
  PAID
  HYBRID
}

enum CampaignChannel {
  INSTAGRAM
  WHATSAPP
  FACEBOOK
  TIKTOK
  TELEGRAM
  MULTICHANNEL
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  LEADS
  SALES
  CONTENT
  COMMUNITY
  WHATSAPP
}

enum GoalMetric {
  FOLLOWERS
  REACH
  VIEWS
  ENGAGEMENTS
  CONTENT_PUBLISHED
  REELS_PUBLISHED
  POSTS_PUBLISHED
  STORIES_PUBLISHED
  WHATSAPP_CONVERSATIONS
  LEADS
  SALES
  REVENUE
  ROAS
  CPA
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

enum IntegrationProvider {
  MANUAL
  META_INSTAGRAM
  META_ADS
  WHATSAPP
  TIKTOK
  TELEGRAM
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum MetricKey {
  FOLLOWERS
  REACH
  VIEWS
  ENGAGEMENTS
  PROFILE_VIEWS
  WEBSITE_CLICKS
  WHATSAPP_CONVERSATIONS
  LEADS
  SALES
  REVENUE
  CONTENT_PUBLISHED
  REELS_PUBLISHED
  POSTS_PUBLISHED
  STORIES_PUBLISHED
}

enum ContentType {
  REEL
  POST
  STORY
  CAROUSEL
  VIDEO
  IMAGE
  TEXT
}

enum ContentStatus {
  IDEA
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
  FAILED
}

enum RecommendationType {
  CONTENT
  CTA
  FREQUENCY
  TIMING
  CHANNEL
  GOAL
}

enum RecommendationStatus {
  OPEN
  APPLIED
  DISMISSED
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELED
}

enum AutopilotMode {
  SAFE
  MANAGED
  AUTOPILOT
  AGGRESSIVE
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadSource {
  INSTAGRAM
  WHATSAPP
  FACEBOOK
  TIKTOK
  TELEGRAM
  ORGANIC
  OTHER
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  active       Boolean      @default(true)
  memberships  Membership[]
  auditLogs    AuditLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Company {
  id                  String                  @id @default(uuid())
  name                String
  slug                String                  @unique
  status              CompanyStatus           @default(ACTIVE)
  timezone            String                  @default("America/Sao_Paulo")
  memberships         Membership[]
  campaigns           Campaign[]
  goals               Goal[]
  auditLogs           AuditLog[]
  integrationAccounts IntegrationAccount[]
  oauthStates         IntegrationOAuthState[]
  metricSnapshots     MetricSnapshot[]
  contentItems        ContentItem[]
  recommendations     Recommendation[]
  experiments         Experiment[]
  autopilotPolicy     AutopilotPolicy?
  leads               Lead[]
  conversations       Conversation[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      UserRole @default(MEMBER)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model Campaign {
  id             String            @id @default(uuid())
  companyId      String
  name           String
  mode           CampaignMode      @default(ORGANIC)
  channel        CampaignChannel   @default(INSTAGRAM)
  objective      CampaignObjective
  status         CampaignStatus    @default(DRAFT)
  budgetTotal    Decimal           @default(0) @db.Decimal(14, 2)
  dailyBudget    Decimal?          @db.Decimal(14, 2)
  plannedReels   Int               @default(0)
  plannedPosts   Int               @default(0)
  plannedStories Int               @default(0)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goals          Goal[]
  contentItems   ContentItem[]
  experiments    Experiment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, mode])
  @@index([createdAt])
}

model Goal {
  id           String      @id @default(uuid())
  companyId    String
  campaignId   String?
  name         String
  metric       GoalMetric
  targetValue  Decimal     @db.Decimal(14, 2)
  currentValue Decimal     @default(0) @db.Decimal(14, 2)
  targetDate   DateTime
  status       GoalStatus  @default(ACTIVE)
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([campaignId])
  @@index([targetDate])
}

model IntegrationAccount {
  id                     String              @id @default(uuid())
  companyId              String
  provider               IntegrationProvider
  status                 IntegrationStatus   @default(PENDING)
  externalAccountId      String?
  displayName            String?
  username               String?
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  scopes                 String[]            @default([])
  tokenExpiresAt         DateTime?
  metadata               Json?
  lastSyncedAt           DateTime?
  errorMessage           String?
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  syncRuns               IntegrationSyncRun[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([companyId, provider, externalAccountId])
  @@index([companyId, provider])
  @@index([companyId, status])
}

model IntegrationOAuthState {
  id        String              @id @default(uuid())
  companyId String
  userId    String
  provider  IntegrationProvider
  state     String              @unique
  expiresAt DateTime
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@index([companyId, provider])
  @@index([expiresAt])
}

model IntegrationSyncRun {
  id                   String             @id @default(uuid())
  integrationAccountId String
  status               SyncStatus         @default(RUNNING)
  recordsRead          Int                @default(0)
  recordsWritten       Int                @default(0)
  errorMessage         String?
  startedAt            DateTime           @default(now())
  finishedAt           DateTime?
  integrationAccount   IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)

  @@index([integrationAccountId, startedAt])
}

model MetricSnapshot {
  id               String              @id @default(uuid())
  companyId        String
  source           IntegrationProvider
  metric           MetricKey
  value            Decimal             @db.Decimal(18, 4)
  externalObjectId String?
  periodStart      DateTime?
  periodEnd        DateTime?
  capturedAt       DateTime            @default(now())
  metadata         Json?
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, metric, capturedAt])
  @@index([companyId, source, capturedAt])
}

model ContentItem {
  id          String        @id @default(uuid())
  companyId   String
  campaignId  String?
  type        ContentType
  status      ContentStatus @default(IDEA)
  title       String
  hook        String?
  script      String?
  caption     String?
  cta         String?
  channel     CampaignChannel
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String?
  metadata    Json?
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@index([campaignId])
}

model Recommendation {
  id          String               @id @default(uuid())
  companyId   String
  type        RecommendationType
  status      RecommendationStatus @default(OPEN)
  title       String
  rationale   String
  actionText  String
  confidence  Decimal              @default(0) @db.Decimal(5, 4)
  impactScore Int                  @default(0)
  evidence    Json?
  generatedAt DateTime             @default(now())
  appliedAt   DateTime?
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, generatedAt])
  @@index([companyId, type])
}

model Experiment {
  id         String           @id @default(uuid())
  companyId  String
  campaignId String?
  name       String
  hypothesis String
  metric     MetricKey
  status     ExperimentStatus @default(DRAFT)
  startedAt  DateTime?
  endedAt    DateTime?
  winnerKey  String?
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign   Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  variants   ExperimentVariant[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([companyId, status])
  @@index([campaignId])
}

model ExperimentVariant {
  id           String     @id @default(uuid())
  experimentId String
  key          String
  label        String
  description  String?
  sampleSize   Int        @default(0)
  metricValue  Decimal    @default(0) @db.Decimal(18, 4)
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([experimentId, key])
  @@index([experimentId])
}

model AutopilotPolicy {
  id                 String        @id @default(uuid())
  companyId          String        @unique
  mode               AutopilotMode @default(SAFE)
  enabled            Boolean       @default(false)
  killSwitch         Boolean       @default(true)
  allowPublishing    Boolean       @default(false)
  allowReplies       Boolean       @default(false)
  allowBudgetChanges Boolean       @default(false)
  maxActionsPerDay   Int           @default(3)
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Lead {
  id            String         @id @default(uuid())
  companyId     String
  name          String?
  phone         String?
  email         String?
  source        LeadSource
  stage         LeadStage      @default(NEW)
  externalId    String?
  campaignTag   String?
  notes         String?
  metadata      Json?
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId, stage])
  @@index([companyId, source])
  @@index([companyId, phone])
}

model Conversation {
  id            String     @id @default(uuid())
  companyId     String
  leadId        String?
  source        LeadSource
  externalId    String?
  startedAt     DateTime   @default(now())
  lastMessageAt DateTime   @default(now())
  messageCount  Int        @default(0)
  metadata      Json?
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead          Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId, lastMessageAt])
  @@index([leadId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  companyId String?
  action    String
  metadata  Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}
