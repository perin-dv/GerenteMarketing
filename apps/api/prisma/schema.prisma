generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignMode {
  ORGANIC
  PAID
  HYBRID
}

enum CampaignChannel {
  INSTAGRAM
  WHATSAPP
  FACEBOOK
  TIKTOK
  TELEGRAM
  MULTICHANNEL
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  LEADS
  SALES
  CONTENT
  COMMUNITY
  WHATSAPP
}

enum GoalMetric {
  FOLLOWERS
  REACH
  VIEWS
  ENGAGEMENTS
  CONTENT_PUBLISHED
  REELS_PUBLISHED
  POSTS_PUBLISHED
  STORIES_PUBLISHED
  WHATSAPP_CONVERSATIONS
  LEADS
  SALES
  REVENUE
  ROAS
  CPA
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  active       Boolean      @default(true)
  memberships  Membership[]
  auditLogs    AuditLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Company {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  status      CompanyStatus @default(ACTIVE)
  timezone    String        @default("America/Sao_Paulo")
  memberships Membership[]
  campaigns   Campaign[]
  goals       Goal[]
  auditLogs   AuditLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      UserRole @default(MEMBER)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model Campaign {
  id             String            @id @default(uuid())
  companyId      String
  name           String
  mode           CampaignMode      @default(ORGANIC)
  channel        CampaignChannel   @default(INSTAGRAM)
  objective      CampaignObjective
  status         CampaignStatus    @default(DRAFT)
  budgetTotal    Decimal           @default(0) @db.Decimal(14, 2)
  dailyBudget    Decimal?          @db.Decimal(14, 2)
  plannedReels   Int               @default(0)
  plannedPosts   Int               @default(0)
  plannedStories Int               @default(0)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goals          Goal[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, mode])
  @@index([createdAt])
}

model Goal {
  id           String      @id @default(uuid())
  companyId    String
  campaignId   String?
  name         String
  metric       GoalMetric
  targetValue  Decimal     @db.Decimal(14, 2)
  currentValue Decimal     @default(0) @db.Decimal(14, 2)
  targetDate   DateTime
  status       GoalStatus  @default(ACTIVE)
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([campaignId])
  @@index([targetDate])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  companyId String?
  action    String
  metadata  Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}
