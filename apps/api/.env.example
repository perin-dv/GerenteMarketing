PORT=4000
DATABASE_URL=postgresql://gerentemarketing:gerentemarketing_dev@localhost:5432/gerentemarketing?schema=public
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Chave base64 de 32 bytes para criptografar tokens de integrações.
# Gere localmente; nunca envie a chave pelo chat nem faça commit do .env real.
INTEGRATION_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Meta / Instagram via Facebook Login for Business.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=http://localhost:4000/integrations/meta/callback

# WhatsApp Cloud API oficial.
WHATSAPP_VERIFY_TOKEN=

# Relay servidor-a-servidor para compartilhar eventos do webhook já existente
# do Tem Na Loja sem substituir o callback atual da Meta.
GERENTEMARKETING_RELAY_SECRET=

# TikTok Login Kit / Display API.
# Para Web, o TikTok exige redirect URI HTTPS registrada no app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-public-domain.example/channels/tiktok/callback

# Telegram Bot API.
# PUBLIC_API_BASE_URL precisa ser HTTPS para registrar webhook real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_API_BASE_URL=https://your-public-domain.example

SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=replace-with-local-password
SEED_ADMIN_NAME=Administrador
SEED_COMPANY_NAME=Tem Na Loja
